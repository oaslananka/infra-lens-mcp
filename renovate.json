{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Repository-local Renovate policy for infra-lens-mcp.",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":separateMultipleMajorReleases",
    "group:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    ":configMigration"
  ],
  "timezone": "Europe/Istanbul",
  "labels": ["dependencies"],
  "dependencyDashboardLabels": ["dependencies"],
  "dependencyDashboardTitle": "Dependency Dashboard",
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "assignees": ["oaslananka"],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 8,
  "branchConcurrentLimit": 8,
  "commitHourlyLimit": 4,
  "rangeStrategy": "bump",
  "rebaseWhen": "conflicted",
  "ignorePaths": ["**/node_modules/**", "**/dist/**", "**/build/**", "**/coverage/**"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"],
    "automerge": false,
    "addLabels": ["lockfile"]
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "prCreation": "immediate",
    "vulnerabilityFixStrategy": "highest"
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Require explicit approval for major version changes.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "addLabels": ["major", "requires-review"],
      "prPriority": -5,
      "automerge": false
    },
    {
      "description": "Apply npm release-age guard to reduce supply-chain churn.",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "3 days",
      "prCreation": "not-pending",
      "internalChecksFilter": "strict",
      "addLabels": ["javascript"]
    },
    {
      "description": "Pin and group non-major GitHub Actions updates.",
      "matchManagers": ["github-actions"],
      "minimumReleaseAge": "3 days",
      "prCreation": "not-pending",
      "internalChecksFilter": "strict",
      "pinDigests": true,
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "addLabels": ["ci", "github-actions"]
    },
    {
      "description": "Group TypeScript quality toolchain updates.",
      "matchPackageNames": [
        "typescript",
        "ts-node",
        "tsx",
        "eslint",
        "eslint-*",
        "@eslint/**",
        "@typescript-eslint/**",
        "typescript-eslint",
        "prettier",
        "@types/**"
      ],
      "groupName": "TypeScript quality toolchain",
      "groupSlug": "typescript-quality-toolchain",
      "addLabels": ["javascript"]
    },
    {
      "description": "Group container image updates.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "minimumReleaseAge": "3 days",
      "prCreation": "not-pending",
      "internalChecksFilter": "strict",
      "groupName": "Container images",
      "groupSlug": "container-images",
      "addLabels": ["docker"]
    },
    {
      "description": "Automerge digest-only updates after checks pass.",
      "matchUpdateTypes": ["digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
      "addLabels": ["automerge"]
    },
    {
      "description": "MCP SDK and infrastructure schema/runtime dependencies require manual review.",
      "matchPackageNames": ["@modelcontextprotocol/sdk", "zod", "systeminformation"],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "addLabels": ["requires-review", "runtime"]
    },
    {
      "description": "Keep Node runtime jumps explicit.",
      "matchPackageNames": ["node", "@types/node"],
      "dependencyDashboardApproval": true,
      "addLabels": ["runtime", "requires-review"]
    },
    {
      "description": "Keep pnpm packageManager and workflow bootstrap pins in one reviewed update.",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm toolchain",
      "groupSlug": "pnpm-toolchain",
      "addLabels": ["javascript", "ci"]
    },
    {
      "description": "Group pre-commit hook revisions and hold them for the release-age window.",
      "matchManagers": ["pre-commit"],
      "minimumReleaseAge": "3 days",
      "prCreation": "not-pending",
      "internalChecksFilter": "strict",
      "groupName": "Pre-commit hooks",
      "groupSlug": "pre-commit-hooks",
      "addLabels": ["security", "area:dx"]
    },
    {
      "description": "Security analysis tool updates require explicit review.",
      "matchPackageNames": [
        "@sonar/scan",
        "semgrep",
        "pre-commit",
        "zizmor",
        "rhysd/actionlint",
        "gitleaks/gitleaks",
        "renovate/renovate"
      ],
      "minimumReleaseAge": "3 days",
      "prCreation": "not-pending",
      "internalChecksFilter": "strict",
      "automerge": false,
      "addLabels": ["security", "requires-review"]
    }
  ],
  "automergeStrategy": "squash",
  "postUpdateOptions": ["pnpmDedupe"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep pnpm workflow bootstrap pins aligned with packageManager.",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/.*\\.ya?ml$/"],
      "matchStrings": ["corepack prepare pnpm@(?<currentValue>\\d+\\.\\d+\\.\\d+) --activate"],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Update pinned Python security tooling used by GitHub Actions.",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/.*\\.ya?ml$/"],
      "matchStrings": [
        "python -m pip install --user (?<depName>[a-z0-9-]+)==(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "description": "Update the pinned actionlint release.",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/security\\.yml$/"],
      "matchStrings": [
        "go install github\\.com/rhysd/actionlint/cmd/actionlint@(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update the pinned Gitleaks release.",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/security\\.yml$/"],
      "matchStrings": [
        "go install github\\.com/zricethezav/gitleaks/v8@(?<currentValue>v?\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "gitleaks/gitleaks",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Update the digest-pinned Renovate validator container used in CI.",
      "managerFilePatterns": ["/^\\.github\\/workflows\\/security\\.yml$/"],
      "matchStrings": [
        "renovate/renovate:(?<currentValue>\\d+\\.\\d+\\.\\d+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "depNameTemplate": "renovate/renovate",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Update the pinned SonarScanner for NPM used by local pre-push analysis.",
      "managerFilePatterns": ["/^scripts\\/run-sonar-local\\.mjs$/"],
      "matchStrings": ["--package=@sonar/scan@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "@sonar/scan",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
